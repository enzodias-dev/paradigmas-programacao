Dim horas As Single
Dim minutos As Single
Dim segundos As Single

Print "--- CONVERSOR DE TEMPO ---"
Input "DIGITE A QUANTIDADE DE HORAS: ", horas

minutos = horas * 60
segundos = horas * 3600

Print "VALOR ORIGINAL: "; horas; " HORAS"
Print "EQUIVALENTE EM MINUTOS: "; minutos
Print "EQUIVALENTE EM SEGUNDOS: "; segundos
Sleep
